rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reservations:
    // Clients can read (e.g. looking up reservation in 'Consultar Mi Reserva' or availability checks)
    // Clients can create new reservations with status 'pendiente_sena'
    // Updates and deletes are allowed for host management
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if request.resource.data.code != null && request.resource.data.guestName != null;
      allow update, delete: if true;
    }

    // Host Settings:
    // Public can read to calculate availability and prices
    // Write allowed for admin panel
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity Logs / Audit Trail:
    // Read and write for recording history of actions
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
